{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,

	"settings": {
		"appearanceTools": true,

		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},

		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#635BFF"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#00D4FF"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#10B981"
				},
				{
					"slug": "warning",
					"name": "Warning",
					"color": "#F59E0B"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#EF4444"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F7F8FC"
				},
				{
